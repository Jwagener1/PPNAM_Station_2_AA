<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Dark, not Light: this theme is only ever seen as the cold-start splash before Compose
        draws its first frame. Inheriting the Light variant flashed a white screen on every
        launch, which is jarring on a shop floor and misrepresents the app's dark graphite UI.
        windowBackground is GraphiteBackground so the splash is indistinguishable from the
        first composed frame.

        The system bars are transparent because MainActivity calls enableEdgeToEdge() — the app
        draws its own bar colours behind them and pads content with window insets (AppScaffold).
    -->
    <style name="Theme.PPNAMStation2AA" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/graphite_background</item>
        <item name="android:colorBackground">@color/graphite_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
