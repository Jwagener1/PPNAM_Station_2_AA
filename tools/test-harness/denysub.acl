# denysub.acl — ACL companion for mosquitto-denysub.conf (A3 fixture, TEST_PLAN §4.1 A3)
#
# `pattern` rules apply to every AUTHENTICATED client regardless of username, so this
# fixture works for whatever credentials/deviceId the handheld is configured with.
#
# In mosquitto ACLs, `read` == subscribe + receive and `write` == publish. Access that is
# not explicitly granted is DENIED. We grant publish everywhere under PPNAM/ and read on
# station presence, but we deliberately grant NO read on any .../res/+ topic:
#
#   - publish req/# and the retained status presence  -> allowed
#   - subscribe PPNAM/{deviceId}/res/+                 -> DENIED  (the whole point of A3)
#   - subscribe PPNAM/station_2/status                 -> allowed (station presence still works)

# The handheld publishes its retained presence and all requests. Allow all PPNAM publishes.
pattern write PPNAM/#

# The handheld may read station presence. This is the ONLY read granted — note there is no
# `pattern read PPNAM/%u/res/+` (or PPNAM/#) line, so the response subscription is refused.
pattern read PPNAM/station_2/status
